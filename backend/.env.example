# Correos autorizados a usar la app (separados por coma)
ALLOWED_EMAILS=espinoza.cristian.silva@gmail.com

# Credenciales de Firebase Admin — elige UNA forma:
# 1) Desarrollo local: ruta al JSON de la cuenta de servicio
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# 2) Producción (Render): pega el JSON COMPLETO en una sola variable
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Orígenes permitidos (frontend) para CORS
CORS_ORIGINS=http://localhost:3000,https://depto-playa.vercel.app
